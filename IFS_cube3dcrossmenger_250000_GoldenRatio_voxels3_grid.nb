Cell[BoxData[
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}]], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"cfc55378-6d4f-4ea4-83e6-6b2aba8bd954"],

Cell["\<\
(* IFS program type*)
(* 3d tetrahedral CrossMenger by Roger L. Bagula 17 April 2004\[Copyright]*)
\
\>", "Input",
 InitializationCell->True,
 AspectRatioFixed->True,
 CellLabel->"In[55]:=",ExpressionUUID->"38162b46-44a3-42f2-b030-04ae16929a5b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{"N", "[", 
    RowBox[{"GoldenRatio", ",", "30"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.9846931528398933`*^9, {3.984694194943623*^9, 3.984694204678361*^9}, 
   3.9846945393502293`*^9},
 CellLabel->"In[58]:=",ExpressionUUID->"0155db39-a5e4-4063-a459-0f9be0a169ef"],

Cell["r=p;", "Input",
 InitializationCell->True,
 CellChangeTimes->{3.984694542367846*^9},
 AspectRatioFixed->True,
 CellLabel->"In[59]:=",ExpressionUUID->"c6e12811-c863-4525-92ac-aa5d98218bc6"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"x", ",", 
   RowBox[{"y", " ", "plane"}]}], "*)"}]], "Input",
 CellLabel->"In[60]:=",ExpressionUUID->"efeffc33-b84d-4126-a1bf-72771d76a5b7"],

Cell["\<\
f1[{x_,y_,z_}] = {-y*p/r+p, x*p/r,z*p/r};
f2[{x_,y_,z_}] = {y/(r*p), x/(r*p),z/(r*p)};
f3[{x_,y_,z_}] = {y/(r*p^2)+1/p, x/(r*p^2),z/(r*p^2)};
\
\>", "Input",
 InitializationCell->True,
 AspectRatioFixed->True,
 CellLabel->"In[61]:=",ExpressionUUID->"e4030bbc-bb46-46c4-9f7a-02dc0576182a"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"x", ",", 
   RowBox[{"z", " ", "plane"}]}], "*)"}]], "Input",
 CellLabel->"In[65]:=",ExpressionUUID->"aa35e282-ad6a-49dd-a6b6-d8f6c001f547"],

Cell["\<\
f4[{x_,y_,z_}] = {z*p/r, y*p/r,-x*p/r+p};
f5[{x_,y_,z_}] = {z/(r*p), y/(r*p),x/(r*p)};
f6[{x_,y_,z_}] = {z/(r*p^2), y/(r*p^2),x/(r*p^2)+1/p};
\
\>", "Input",
 InitializationCell->True,
 AspectRatioFixed->True,
 CellLabel->"In[66]:=",ExpressionUUID->"3f65f42e-6f04-4b9d-a7b4-fbc2e1596bf9"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"y", ",", 
   RowBox[{"z", " ", "plane"}]}], "*)"}]], "Input",
 CellLabel->"In[70]:=",ExpressionUUID->"fd744225-abae-43a8-9822-6028ecfd4730"],

Cell["\<\
f7[{x_,y_,z_}] = {x*p/r, -z*p/r+p,y*p/r};
f8[{x_,y_,z_}] = {x/(r*p),z/(r*p), y/(r*p)};
f9[{x_,y_,z_}] = {x/(r*p^2),z/(r*p^2)+1/p,y/(r*p^2)};
\
\>", "Input",
 InitializationCell->True,
 AspectRatioFixed->True,
 CellLabel->"In[71]:=",ExpressionUUID->"87b76b4c-5f95-4896-9573-a672b4360d22"],

Cell["\<\
f[x_] := Which[(r=Random[]) <= 1/4, f1[x],
\tr <=2/4, f2[x],r <= 3/4, f3[x],r <=3/4+ 1/24, f4[x],
\tr <=3/4+ 2/24, f5[x],r <= 3/4+ 3/24, f6[x],r <= 3/4+ 4/24, f7[x],
\tr <=3/4+ 5/24, f8[x],r <= 1, f9[x]]\t\
\>", "Input",
 InitializationCell->True,
 AspectRatioFixed->True,
 CellLabel->"In[75]:=",ExpressionUUID->"95c7b8be-a1dd-49a9-9553-9ede1c177378"],

Cell["ifs[n_] :=NestList[f, {0,0,0}, n];", "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.984692655278302*^9, 3.984692688972979*^9}, 
   3.984693012899219*^9, {3.984693223877596*^9, 3.9846932380445127`*^9}, {
   3.9926208118107357`*^9, 3.992620825776046*^9}, {3.992620971521888*^9, 
