 RowBox[{"\n", 
  RowBox[{"(*", 
   RowBox[{"6.", " ", "Voxelization"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"voxel", "=", "0.02"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"voxels", "=", 
     RowBox[{"DeleteDuplicates", "[", 
