Cell[BoxData[
 RowBox[{
  RowBox[{"TubePlotFrenet", "[", 
   RowBox[{"curve_List", ",", 
    RowBox[{"{", 
     RowBox[{"var_", ",", "min_", ",", "max_"}], "}"}], ",", "radius_", ",", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tangent", ",", "unitTangent", ",", "normal", ",", "unitNormal", ",", 
      "biNormal"}], "}"}], ",", 
    RowBox[{
     RowBox[{"tangent", "=", 
      RowBox[{"D", "[", 
       RowBox[{"curve", ",", "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"unitTangent", "=", 
      RowBox[{"tangent", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"tangent", ".", "tangent"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"normal", "=", 
      RowBox[{"D", "[", 
       RowBox[{"unitTangent", ",", "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"unitNormal", "=", 
      RowBox[{"normal", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"normal", ".", "normal"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"biNormal", "=", 
      RowBox[{"Cross", "[", 
       RowBox[{"unitTangent", ",", "unitNormal"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"curve", "+", 
         RowBox[{"radius", " ", 
          RowBox[{"Cos", "[", "s", "]"}], " ", "unitNormal"}], "+", 
         RowBox[{"radius", " ", 
          RowBox[{"Sin", "[", "s", "]"}], " ", "biNormal"}]}], "//", 
        "Evaluate"}], ",", 
       RowBox[{"{", 
        RowBox[{"var", ",", "min", ",", "max"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "0", ",", 
         RowBox[{"2", "\[Pi]"}]}], "}"}], ",", 
       RowBox[{"Exclusions", "->", "None"}], ",", "opts"}], "]"}]}]}], 
   "]"}]}]], "Input",
