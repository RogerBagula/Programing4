Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"GoldenRatio", " ", "Torus", " ", "Knot"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "p_", "]"}], "=", 
     RowBox[{"Cos", "[", "p", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"g", "[", "p_", "]"}], "=", 
     RowBox[{"Sin", "[", "p", "]"}]}], ";"}], "\n", 
   RowBox[{"phi", "=", 
    RowBox[{"N", "[", "GoldenRatio", "]"}]}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p0", ",", "q0"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "phi"}], ",", "phi"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r", "=", 
     RowBox[{"2", "+", 
      RowBox[{"f", "[", 
       RowBox[{"q0", "*", "t"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x", "=", " ", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"p0", "*", "t"}], "]"}], "*", "r"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"y", "=", 
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{"p0", "*", "t"}], "]"}], "*", "r"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"z", "=", 
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{"q0", "*", "t"}], "]"}], "*", "r"}]}], ";"}], "\n", 
   RowBox[{"w", "=", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"0.6180339887498948`", " ", "t"}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{"2", "+", 
        RowBox[{"Cos", "[", 
