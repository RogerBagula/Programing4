Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"colortab", "=", 
    RowBox[{"N", "@", 
     RowBox[{"Sort", "@", 
      RowBox[{"Union", "@", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{"1", "-", "j"}], ",", 
                  RowBox[{"1", "-", "k"}]}], "}"}], "^", "2"}], ",", 
               RowBox[{"{", 
                RowBox[{"n", ",", "0", ",", "1", ",", 
                 RowBox[{"1", "/", "30"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "0", ",", "1", ",", 
                 RowBox[{"1", "/", "10"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "0", ",", "1", ",", 
                 RowBox[{"1", "/", "10"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "0", ",", "1", ",", 
                 RowBox[{"1", "/", "10"}]}], "}"}]}], "]"}], ",", "3"}], 
            "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "+", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "+", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], ")"}]}], "==", "1"}], 
            "&"}]}], "   ", 
          RowBox[{"(*", 
           RowBox[{"your", " ", "condition", " ", "rewritten"}], "*)"}], 
          "]"}], ",", 
         RowBox[{
          RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "/@", 
          RowBox[{"Subdivide", "[", 
