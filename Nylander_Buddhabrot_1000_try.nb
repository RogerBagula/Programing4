Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Mandelbrot", "[", "zc_", "]"}], ":=", 
   RowBox[{"Length", "[", 
    RowBox[{"NestWhileList", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#", "^", "2"}], "+", "zc"}], "&"}], ",", "0", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "#", "]"}], "<", "2"}], "&"}], ",", "1", ",", 
      "1000"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"n", "=", "1000"}], ";", 
  RowBox[{"image", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", "n", "}"}], ",", 
     RowBox[{"{", "n", "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.991977281757922*^9, 3.991977336608683*^9}, {
  3.992081765554763*^9, 3.992081774969121*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"913cf9df-56a8-45d8-aa69-e2ca8f6f02c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Mandelbrot", "[", 
        RowBox[{"xc", "+", 
         RowBox[{"I", " ", "yc"}]}], "]"}], "<", "1000"}], ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"z", "=", "0"}], ",", 
          RowBox[{"iter", "=", "0"}]}], "}"}], ",", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "z", "]"}], "<", "2"}], ",", 
          RowBox[{
           RowBox[{"z", "=", 
            RowBox[{
             RowBox[{"z", "^", "2"}], "+", "xc", "+", 
             RowBox[{"I", " ", "yc"}]}]}], ";", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", "j"}], "}"}], "=", 
            RowBox[{"Floor", "[", 
             RowBox[{"n", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Im", "[", "z", "]"}], "+", "1.5"}], ",", 
                 RowBox[{
                  RowBox[{"Re", "[", "z", "]"}], "+", "2"}]}], "}"}], "/", 
               "3"}]}], "]"}]}], ";", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"0", "<", "i", "<=", "n"}], "&&", 
              RowBox[{"0", "<", "j", "<=", "n"}]}], ",", 
             RowBox[{
              RowBox[{"image", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "+=", 
              RowBox[{"xc", "+", 
               RowBox[{"I", " ", "yc"}]}]}]}], "]"}], ";", 
           RowBox[{"iter", "++"}]}]}], "]"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"xc", ",", 
      RowBox[{"-", "2.0"}], ",", "1.0", ",", "0.01"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"yc", ",", 
      RowBox[{"-", "1.5"}], ",", "1.5", ",", "0.01"}], "}"}]}], "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.991977281757922*^9, 3.991977336608683*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"e3fa1a37-372e-46bb-91c4-8a5363659706"],

