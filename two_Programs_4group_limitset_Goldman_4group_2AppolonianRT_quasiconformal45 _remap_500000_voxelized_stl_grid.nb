          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"idxList", "=", 
               RowBox[{"{", "}"}]}], ",", 
              RowBox[{"last", "=", "None"}], ",", "idx", ",", "k", ",", "M", 
              ",", "p", ",", "firstIdx"}], "}"}], ",", 
            RowBox[{
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"idx", "=", 
                 RowBox[{"RandomInteger", "[", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", "8"}], "}"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"last", "=!=", "None"}], "&&", 
                   RowBox[{
                    RowBox[{"inverseIndex", "[", "last", "]"}], "===", 
                    "idx"}]}], ",", 
                  RowBox[{"idx", "=", 
                   RowBox[{
                    RowBox[{"Mod", "[", 
                    RowBox[{"idx", ",", "8"}], "]"}], "+", "1"}]}]}], "]"}], 
                ";", "\[IndentingNewLine]", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"idxList", ",", "idx"}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"last", "=", "idx"}], ";"}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "wordLength"}], "}"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"firstIdx", "=", 
              RowBox[{"idxList", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"M", "=", 
              RowBox[{"normalizeSL3", "@", 
               RowBox[{"Fold", "[", 
                RowBox[{"Dot", ",", 
                 RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"generators", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], "&"}], "/@", 
                  "idxList"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
