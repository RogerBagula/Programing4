    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
             "explicit", " ", "list", " ", "of", " ", "24", " ", "colors"}], 
             ")"}], "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], 
     "--"}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"nColors", "=", "24"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"colorsList", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ColorData", "[", "\"\<DarkRainbow\>\"", "]"}], "[", 
        RowBox[{"Rescale", "[", 
         RowBox[{"i", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "nColors"}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nColors"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
