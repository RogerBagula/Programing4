     RowBox[{
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", "Color"}]}]}]}]}]}]}]}], " ", "by", " ", "first"}],
      "-", 
     RowBox[{"generator", " ", "heuristic", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", "sample", ")"}], "--"}], "--"}], "--"}], "--"}], 
          "--"}], "--"}], "--"}], "--"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "4321", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sampleN", "=", 
     RowBox[{"Min", "[", 
      RowBox[{
       RowBox[{"Length", "[", "points", "]"}], ",", "numOrbits"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"colorAssoc", "=", 
     RowBox[{
      RowBox[{"Reap", "[", 
       RowBox[{
        RowBox[{"Do", "[", 
