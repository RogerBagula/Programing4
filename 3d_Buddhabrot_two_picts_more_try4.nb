Cell[BoxData[
 RowBox[{
  RowBox[{"iterates", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"c", ",", "_Real", ",", "1"}], "}"}], "}"}], ",", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "[", "#", "]"}], ",", 
          RowBox[{"Im", "[", "#", "]"}]}], "}"}], "&"}], ",", 
       RowBox[{"NestList", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "^", "2"}], "+", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "I"}], "}"}], ".", 
            RowBox[{"c", "[", 
             RowBox[{"[", 
              RowBox[{"{", 
               RowBox[{"1", ",", "2"}], "}"}], "]"}], "]"}]}]}], "&"}], ",", 
         RowBox[{"0.0", "+", 
          RowBox[{"0.0", "*", "I"}]}], ",", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "-", "10"}], "]"}]}], "]"}]}], 
      "]"}], ",", 
     RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
     RowBox[{"Parallelization", "->", "True"}], ",", 
     RowBox[{"RuntimeAttributes", "->", 
      RowBox[{"{", "Listable", "}"}]}], ",", 
     RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.992016592856316*^9, 3.9920165928628597`*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"61ac5b15-b06e-48e2-ad09-849a24489732"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bp", ",", "bins", ",", "d", ",", "p", ",", "len", ",", 
     RowBox[{"xmin", "=", 
      RowBox[{"-", "1.5"}]}], ",", 
     RowBox[{"xmax", "=", "1.0"}], ",", 
     RowBox[{"ymin", "=", 
      RowBox[{"-", "1.1"}]}], ",", 
     RowBox[{"ymax", "=", "1.1"}], ",", 
     RowBox[{"delta", "=", "0.001"}], ",", "tx", ",", "ty"}], "}"}], ",", 
   RowBox[{
    RowBox[{"bp", "=", 
     RowBox[{"borderpoints", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", 
        RowBox[{"-", "1"}], ";;", "5"}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"bins", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"Floor", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ymax", "-", "ymin"}], ",", 
            RowBox[{"xmax", "-", "xmin"}]}], "}"}], "/", "delta"}], "]"}], "+", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}]}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"d", "=", 
     RowBox[{"Dimensions", "[", "bins", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"p", "=", 
        RowBox[{"Drop", "[", 
         RowBox[{
          RowBox[{"iterates", "[", 
           RowBox[{"bp", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "]"}], ",", "100"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"len", "=", 
        RowBox[{"Length", "[", "p", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"tx", "=", 
           RowBox[{
            RowBox[{"Floor", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"p", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}], "-", "xmin"}], ")"}],
               "/", "delta"}], "]"}], "+", "1"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"ty", "=", 
           RowBox[{
            RowBox[{"Floor", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"p", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}], "+", "ymax"}], ")"}],
               "/", "delta"}], "]"}], "+", "1"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"tx", ">=", "1"}], "&&", 
             RowBox[{"tx", "<=", 
              RowBox[{"d", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "&&", 
             RowBox[{"ty", ">=", "1"}], "&&", 
             RowBox[{"ty", "<=", 
              RowBox[{"d", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
            RowBox[{
             RowBox[{"bins", "[", 
              RowBox[{"[", 
               RowBox[{"ty", ",", "tx"}], "]"}], "]"}], "+=", 
             RowBox[{"N", "[", "GoldenRatio", "]"}]}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "len"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", 
        RowBox[{"Length", "[", "bp", "]"}]}], "}"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Export", "[", 
     RowBox[{"\"\<bins.dat\>\"", ",", 
      RowBox[{"Transpose", "[", "bins", "]"}]}], "]"}]}]}], "]"}]], "Input",
