Cell[BoxData[
 RowBox[{
  RowBox[{"InitialTriangle", "[", "dx_", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", "=", "0.2"}], "}"}], ",", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"Quiet", "[", 
        RowBox[{"MandelbrotSetMemberQ", "[", "x", "]"}], "]"}], ",", 
       RowBox[{"x", "+=", "dx"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "-", "dx"}], ",", "0.0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0.0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "dx", ",", 
         RowBox[{"Boole", "[", 
          RowBox[{"Quiet", "[", 
           RowBox[{"MandelbrotSetMemberQ", "[", 
            RowBox[{"x", "+", 
             RowBox[{"I", "*", "dx"}]}], "]"}], "]"}], "]"}]}], "}"}]}], 
      "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.992016541932226*^9, 3.992016541946595*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"1096797d-9c4e-439b-a2a5-43afa28d691d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BorderTriangles", "[", "dx_", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "t", ",", "t1", ",", "zflip", ",", "zin", ",", "zout", ",", "znew"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"t", "=", 
      RowBox[{"InitialTriangle", "[", "dx", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"t1", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"Round", "[", 
        RowBox[{"t", ",", 
         RowBox[{"10.", "^", 
          RowBox[{"-", "10"}]}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"t", "[", 
         RowBox[{"[", 
          RowBox[{"3", ",", "3"}], "]"}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"zflip", "=", 
         RowBox[{"t", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", 
        RowBox[{"zin", "=", 
         RowBox[{"t", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], ";", 
        RowBox[{"zout", "=", 
         RowBox[{"t", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"zflip", "=", 
         RowBox[{"t", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", 
        RowBox[{"zin", "=", 
         RowBox[{"t", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", 
        RowBox[{"zout", "=", 
         RowBox[{"t", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"{", "t", "}"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
      "enclose", " ", "in", " ", "braces", " ", "for", " ", "Join", " ", 
       "below"}], "*)"}], 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"znew", "=", 
         RowBox[{"zin", "+", "zout", "-", "zflip"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"Quiet", "[", 
           RowBox[{"MandelbrotSetMemberQ", "[", 
            RowBox[{
             RowBox[{"Most", "[", "znew", "]"}], ".", 
             RowBox[{"{", 
              RowBox[{"1", ",", "I"}], "}"}]}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"zflip", "=", "zin"}], ";", 
           RowBox[{"zin", "=", 
            RowBox[{"ReplacePart", "[", 
             RowBox[{"znew", ",", 
              RowBox[{"3", "->", "1"}]}], "]"}]}]}], ",", 
          RowBox[{"(*", 
           RowBox[{"same", " ", "zout"}], "*)"}], 
          RowBox[{
           RowBox[{"zflip", "=", "zout"}], ";", 
           RowBox[{"zout", "=", 
            RowBox[{"ReplacePart", "[", 
             RowBox[{"znew", ",", 
              RowBox[{"3", "->", "0"}]}], "]"}]}]}]}], " ", 
         RowBox[{"(*", 
          RowBox[{"same", " ", "zin"}], "*)"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Sort", "[", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"zflip", ",", "zin", ",", "zout"}], "}"}], ",", 
            RowBox[{"10.", "^", 
             RowBox[{"-", "10"}]}]}], "]"}], "]"}], "=!=", "t1"}]}], ",", 
       RowBox[{"t", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"t", ",", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"zflip", ",", "zin", ",", "zout"}], "}"}], "}"}]}], 
         "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", "t"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.992016556450547*^9, 3.9920165564591627`*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"4b1603da-a40e-46f8-a970-2215180d765d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DeepPoints", "[", 
   RowBox[{"dx_", ",", "itmin_", ",", "itmax_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Most", "[", 
          RowBox[{"Mean", "[", "#", "]"}], "]"}], "&"}], ",", 
        RowBox[{"BorderTriangles", "[", "dx", "]"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"p", ",", 
         RowBox[{"MandelbrotSetIterationCount", "[", 
          RowBox[{
           RowBox[{"p", ".", 
            RowBox[{"{", 
             RowBox[{"1", ",", "I"}], "}"}]}], ",", 
           RowBox[{"MaxIterations", "->", "itmax"}]}], "]"}]}], "}"}], "]"}], 
      ",", 
      RowBox[{"_", "?", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"itmin", "<=", 
          RowBox[{"Last", "[", "#", "]"}], "<", "itmax"}], "&"}], ")"}]}]}], 
     "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.992016576053926*^9, 3.992016576060835*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"96e4f926-8a88-444b-89cd-756c30ce45fd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"borderpoints", "=", 
   RowBox[{"Reverse", "[", 
    RowBox[{"SortBy", "[", 
     RowBox[{
      RowBox[{"Map", "[", 
       RowBox[{"Flatten", ",", 
        RowBox[{"N", "[", 
         RowBox[{"DeepPoints", "[", 
          RowBox[{"0.001", ",", "1000", ",", "500000"}], "]"}], "]"}]}], 
       "]"}], ",", "Last"}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.992018646271525*^9, 3.992018646284832*^9}, {
  3.9920199776558313`*^9, 3.992019978387478*^9}, {3.992020675242841*^9, 
