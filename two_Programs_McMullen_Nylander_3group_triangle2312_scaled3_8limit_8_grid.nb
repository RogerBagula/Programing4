       RowBox[{"Developer`ToPackedArray", "@", 
        RowBox[{"Take", "[", 
         RowBox[{"pts", ",", 
          RowBox[{"idx", "-", "1"}]}], "]"}]}]}]}], "]"}]}], ";"}]}]], "Input",\

