      RowBox[{"0", " ", "at", " ", "inner", " ", "radius"}]}], ",", 
     RowBox[{"1", " ", "at", " ", "outer", " ", "radius"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"radialFactor", "[", 
      RowBox[{"pt_", ",", "rmin_", ",", "rmax_", ",", 
       RowBox[{"amp_", ":", "1.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", "u"}], "}"}], ",", 
       RowBox[{
        RowBox[{"r", "=", 
         RowBox[{"Norm", "[", "pt", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"u", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", "-", "rmin"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"rmax", "-", "rmin"}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Exp", "[", 
         RowBox[{"amp", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", "u"}], ")"}]}], "]"}]}]}], "          ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{">", 
         RowBox[{"1", " ", "inside"}]}], ",", " ", 
        RowBox[{
         RowBox[{"~", "1"}], " ", "near", " ", "boundary"}]}], "*)"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"spherePtsDisplacedRaw", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"radialFactor", "[", 
         RowBox[{
          RowBox[{"pts", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", "rmin", ",", "rmax", ",", 
          "1.0"}], "]"}], "*", 
        RowBox[{"Normalize", "[", 
         RowBox[{"pts", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "pts", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Renormalize", " ", "to", " ", "unit", " ", "sphere"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"spherePtsDisplaced", "=", 
     RowBox[{"Normalize", "/@", "spherePtsDisplacedRaw"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
