Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"===", "===", "===", "===", "===", "===", "===", "==="}], "="}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"M\[ODoubleDot]bius", " ", "machinery", " ", 
    RowBox[{"(", 
     RowBox[{"pole", "-", "avoiding"}], ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"===", "===", "===", "===", "===", "===", "===", "==="}], "="}], 
   "*)"}], "\n", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"mobApply", "[", "m_", "]"}], "[", 
      RowBox[{"z_", ",", 
       RowBox[{"eps_", ":", 
        RowBox[{"10", "^", 
         RowBox[{"-", "12"}]}]}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "den"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", "b"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"c", ",", "d"}], "}"}]}], "}"}], "=", "m"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"den", "=", 
         RowBox[{
          RowBox[{"c", "*", "z"}], "+", "d"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "den", "]"}], "<", "eps"}], ",", 
          RowBox[{"Missing", "[", "\"\<Pole\>\"", "]"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"a", "*", "z"}], "+", "b"}], ")"}], "/", "den"}]}], 
         "]"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mobCompose", "[", 
      RowBox[{"m1_", ",", "m2_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "a1", ",", "b1", ",", "c1", ",", "d1", ",", "a2", ",", "b2", ",", 
         "c2", ",", "d2"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a1", ",", "b1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"c1", ",", "d1"}], "}"}]}], "}"}], "=", "m1"}], ";", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a2", ",", "b2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"c2", ",", "d2"}], "}"}]}], "}"}], "=", "m2"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"a1", " ", "a2"}], "+", 
             RowBox[{"b1", " ", "c2"}]}], ",", 
            RowBox[{
             RowBox[{"a1", " ", "b2"}], "+", 
             RowBox[{"b1", " ", "d2"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"c1", " ", "a2"}], "+", 
             RowBox[{"d1", " ", "c2"}]}], ",", 
            RowBox[{
             RowBox[{"c1", " ", "b2"}], "+", 
             RowBox[{"d1", " ", "d2"}]}]}], "}"}]}], "}"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"mobInverse", "[", "m_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "det"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", "b"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"c", ",", "d"}], "}"}]}], "}"}], "=", "m"}], ";", 
        RowBox[{"det", "=", 
         RowBox[{
          RowBox[{"a", " ", "d"}], "-", 
          RowBox[{"b", " ", "c"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"d", "/", "det"}], ",", 
            RowBox[{
             RowBox[{"-", "b"}], "/", "det"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "c"}], "/", "det"}], ",", 
            RowBox[{"a", "/", "det"}]}], "}"}]}], "}"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
