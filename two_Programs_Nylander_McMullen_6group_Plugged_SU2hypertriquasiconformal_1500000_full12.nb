Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"===", "===", "===", "===", "===", "===", "===", "==="}], "="}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"McMullen", "-", 
    RowBox[{"style", " ", "random", " ", "orbit", " ", 
     RowBox[{"(", 
      RowBox[{"pole", "-", "avoiding"}], ")"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"===", "===", "===", "===", "===", "===", "===", "==="}], "="}], 
   "*)"}], "\n", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"buildOrbit", "[", 
     RowBox[{
      RowBox[{"nPoints_", ":", "1500000"}], ",", 
      RowBox[{"z0_", ":", 
       RowBox[{"0", "+", 
        RowBox[{"0", " ", "I"}]}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"z", "=", "z0"}], ",", "pts", ",", 
        RowBox[{"idx", "=", "1"}], ",", 
        RowBox[{"attempts", "=", "0"}], ",", 
        RowBox[{"maxAttempts", "=", 
         RowBox[{"50", " ", "nPoints"}]}], ",", "w", ",", "znew", ",", 
        RowBox[{"poleHits", "=", "0"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"pts", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"0.", "+", 
           RowBox[{"0.", " ", "I"}]}], ",", "nPoints"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"idx", "<=", "nPoints"}], "&&", 
          RowBox[{"attempts", "<", "maxAttempts"}]}], ",", 
         RowBox[{
          RowBox[{"attempts", "++"}], ";", "\[IndentingNewLine]", 
          RowBox[{"w", "=", 
           RowBox[{"RandomChoice", "[", "generators", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"znew", "=", 
           RowBox[{
            RowBox[{"mobApply", "[", "w", "]"}], "[", "z", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"znew", "===", 
             RowBox[{"Missing", "[", "\"\<Pole\>\"", "]"}]}], ",", 
            RowBox[{
             RowBox[{"poleHits", "++"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Continue", "[", "]"}]}], ",", 
            RowBox[{
             RowBox[{"z", "=", "znew"}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", "z", "]"}], "<", "50"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"pts", "[", 
                  RowBox[{"[", "idx", "]"}], "]"}], "=", "z"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"idx", "++"}], ";"}]}], "]"}], ";"}]}], "]"}], 
          ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Attempts=\>\"", ",", "attempts", ",", "\"\<  stored=\>\"", ",", 
         RowBox[{"idx", "-", "1"}], ",", "\"\<  poleHits=\>\"", ",", 
         "poleHits"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Developer`ToPackedArray", "@", 
        RowBox[{"Take", "[", 
         RowBox[{"pts", ",", 
          RowBox[{"idx", "-", "1"}]}], "]"}]}]}]}], "]"}]}], ";"}]}]], "Input",\

