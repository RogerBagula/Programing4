      RowBox[{
       RowBox[{"rmin", "=", 
        RowBox[{"Min", "[", "r", "]"}]}], ";", 
       RowBox[{"rmax", "=", 
        RowBox[{"Max", "[", "r", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"f", "=", 
        RowBox[{"ColorData", "[", "\"\<DarkRainbow\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
