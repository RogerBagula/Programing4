   RowBox[{
    RowBox[{"g3", "=", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"PointSize", "[", "0.0025", "]"}], ",", 
