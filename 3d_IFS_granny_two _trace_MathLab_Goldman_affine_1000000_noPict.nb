Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Build"}]}], " ", "Goldman", " ", "matrices", " ", "and", 
     " ", 
     RowBox[{"verify", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Gs", "=", 
     RowBox[{"SL2CToSO31", "/@", "SLgens"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eta", "=", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Goldman matrices:\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<G\>\"", ",", "i", ",", "\"\< = \>\"", ",", 
        RowBox[{"MatrixForm", "[", 
         RowBox[{"Gs", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "Gs", "]"}]}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Minkowski checks (should be ~zero):\>\"", "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Check G\>\"", ",", "i", ",", "\"\<: \>\"", ",", 
        RowBox[{"Chop", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"Gs", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}], ".", "eta", ".", 
            RowBox[{"Gs", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "-", "eta"}], ",", 
          RowBox[{"10", "^", 
           RowBox[{"-", "10"}]}]}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "Gs", "]"}]}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Determinants: \>\"", ",", 
      RowBox[{"Det", "/@", "Gs"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Projective"}]}], " ", "action", " ", "on", " ", 
      RowBox[{"R", "^", "3"}], " ", "via", " ", "homogeneous", " ", "coords", 
      " ", 
      RowBox[{"(", 
       RowBox[{"x", ",", "y", ",", "z", ",", "1"}], ")"}]}], "->", 
     RowBox[{
      RowBox[{"divide", " ", "by", " ", 
       RowBox[{"w", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ApplyProjective", "[", 
      RowBox[{"G_", ",", "pt_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"v", ",", "w"}], "}"}], ",", 
       RowBox[{
        RowBox[{"v", "=", 
         RowBox[{"G", ".", 
          RowBox[{"Append", "[", 
           RowBox[{"pt", ",", "1.0"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"w", "=", 
         RowBox[{"v", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "w", "]"}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "12"}]}]}], ",", "$Failed", ",", 
          RowBox[{
           RowBox[{"v", "[", 
            RowBox[{"[", 
             RowBox[{"1", ";;", "3"}], "]"}], "]"}], "/", "w"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Random"}]}], " ", "IFS", " ", "sampler", " ", 
      RowBox[{"parameters", "--"}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "1234", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nIter", "=", "1000000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"burnIn", "=", "100"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pt", "=", 
     RowBox[{"{", 
      RowBox[{"0.05", ",", "0.02", ",", "0.01"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pts", "=", 
     RowBox[{
      RowBox[{"Reap", "[", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"p", "=", "pt"}], ",", "g", ",", "newp", ",", "i"}], "}"}],
          ",", 
         RowBox[{
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "1"}], ",", 
            RowBox[{"i", "<=", "nIter"}], ",", 
            RowBox[{"i", "++"}], ",", 
            RowBox[{
             RowBox[{"g", "=", 
              RowBox[{"RandomChoice", "[", "Gs", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"newp", "=", 
              RowBox[{"ApplyProjective", "[", 
               RowBox[{"g", ",", "p"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"newp", "===", "$Failed"}], "||", 
                RowBox[{"!", 
                 RowBox[{"VectorQ", "[", 
                  RowBox[{"newp", ",", "NumericQ"}], "]"}]}], "||", 
                RowBox[{
                 RowBox[{"Norm", "[", "newp", "]"}], ">", "1.0*^6"}]}], ",", 
               RowBox[{
                RowBox[{"p", "=", 
                 RowBox[{"RandomReal", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "0.5"}], ",", "0.5"}], "}"}], ",", "3"}], 
                  "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"p", "=", "newp"}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"i", ">", "burnIn"}], ",", 
               RowBox[{"Sow", "[", "p", "]"}]}], "]"}], ";"}]}], "]"}], 
          ";"}]}], "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Downsample", " ", "for", " ", "plotting", " ", "if", " ", "needed"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "pts", "]"}], ">", "120000"}], ",", 
        RowBox[{"RandomSample", "[", 
         RowBox[{"pts", ",", "120000"}], "]"}], ",", "pts"}], "]"}]}], ";"}], 
    "*)"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.990967953725968*^9, 3.99096795373381*^9}, 
