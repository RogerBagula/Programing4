        RowBox[{"Rescale", "[", 
         RowBox[{"r", ",", 
          RowBox[{"{", 
           RowBox[{"rmin", ",", "rmax"}], "}"}]}], "]"}]}]}]}], "]"}]}], 
   ";"}]}]], "Input",
