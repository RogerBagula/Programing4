   RowBox[{
    RowBox[{"s1", "=", 
     RowBox[{"s", "[", "1", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s2", "=", 
     RowBox[{"s", "[", "2", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s3", "=", 
     RowBox[{"Inverse", "[", "s1", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s4", "=", 
     RowBox[{"Inverse", "[", "s2", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SLgens", "=", 
     RowBox[{"{", 
      RowBox[{"s1", ",", "s2", ",", "s3", ",", "s4"}], "}"}]}], 
    ";"}]}]}]], "Input",
