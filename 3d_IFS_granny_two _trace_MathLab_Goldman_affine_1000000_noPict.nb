      RowBox[{"2", ",", "C"}], ")"}], " ", "generators", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
       "use", " ", "your", " ", "SLgens", " ", "if", " ", "already", " ", 
        "defined"}], ")"}], "--"}]}], "-"}], "*)"}], "\n", 
