Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"IFS", " ", "sampler"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ifsSample", "[", 
      RowBox[{"Gs_List", ",", "nIter_Integer", ",", 
       RowBox[{"burnIn_Integer", ":", "500"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", "=", 
          RowBox[{"{", 
           RowBox[{"0.05", ",", "0.02", ",", "0.01"}], "}"}]}], ",", "k", ",",
          "g", ",", "newp", ",", "pts", ",", "gens", ",", "len"}], "}"}], ",", 
       RowBox[{
        RowBox[{"len", "=", 
         RowBox[{"nIter", "-", "burnIn"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"pts", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.", ",", 
           RowBox[{"{", 
            RowBox[{"len", ",", "3"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gens", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", "len"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"k", "=", 
            RowBox[{"RandomInteger", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", 
               RowBox[{"Length", "[", "Gs", "]"}]}], "}"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"g", "=", 
            RowBox[{"Gs", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"newp", "=", 
            RowBox[{"ApplyProjective", "[", 
             RowBox[{"g", ",", "p"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"newp", "===", "$Failed"}], "||", 
              RowBox[{
               RowBox[{"Norm", "[", "newp", "]"}], ">", "1.*^6"}]}], ",", 
             RowBox[{"p", "=", 
              RowBox[{"RandomReal", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "0.5"}], ",", "0.5"}], "}"}], ",", "3"}], 
               "]"}]}], ",", 
             RowBox[{
              RowBox[{"p", "=", "newp"}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"i", ">", "burnIn"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"pts", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", "-", "burnIn"}], "]"}], "]"}], "=", "p"}], 
                 ";", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"gens", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", "-", "burnIn"}], "]"}], "]"}], "=", "k"}], 
                 ";"}]}], "]"}], ";"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "nIter"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"pts", ",", "gens"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
