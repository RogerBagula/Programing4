Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"s1", "=", 
     RowBox[{"N", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "+", "I"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"1", "-", "I"}]}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s2", "=", 
     RowBox[{"N", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", " ", "I"}], ",", "1"}], "}"}]}], "}"}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"s3", "=", 
     RowBox[{"Inverse", "[", "s1", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s4", "=", 
     RowBox[{"Inverse", "[", "s2", "]"}]}], ";"}], "\n"}]}]], "Input",
