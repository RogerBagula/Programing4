Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Run", " ", "IFS"}], "*)"}], "\n", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "1234", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nIter", "=", "200000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ptsBase", ",", "genID"}], "}"}], "=", 
     RowBox[{"ifsSample", "[", 
      RowBox[{"Gs", ",", "nIter", ",", "500"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Colors", "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"genColors", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RGBColor", "[", 
        RowBox[{"0.9", ",", "0.2", ",", "0.2"}], "]"}], ",", 
       RowBox[{"RGBColor", "[", 
        RowBox[{"0.2", ",", "0.6", ",", "0.9"}], "]"}], ",", 
       RowBox[{"RGBColor", "[", 
        RowBox[{"0.2", ",", "0.8", ",", "0.3"}], "]"}], ",", 
       RowBox[{"RGBColor", "[", 
        RowBox[{"0.9", ",", "0.7", ",", "0.2"}], "]"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"colorsBase", "=", 
     RowBox[{"genColors", "[", 
      RowBox[{"[", "genID", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"4", "\[Times]", "mirroring"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pts0", "=", "ptsBase"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pts1", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"ptsBase", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{"ptsBase", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"ptsBase", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "}"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"pts2", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ptsBase", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"-", 
         RowBox[{"ptsBase", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", 
        RowBox[{"ptsBase", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "}"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"pts3", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"ptsBase", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{"-", 
         RowBox[{"ptsBase", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", 
        RowBox[{"ptsBase", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ptsAll", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"pts0", ",", "pts1", ",", "pts2", ",", "pts3"}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"ptColorsAll", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
      "colorsBase", ",", "colorsBase", ",", "colorsBase", ",", "colorsBase"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Normalize", " ", "to", " ", "sphere"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"spherePts", "=", 
     RowBox[{"Normalize", "/@", "ptsAll"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Rotation", ":", 
     RowBox[{
      RowBox[{"90", " ", "degrees", " ", "about", " ", "z"}], "-", "axis"}]}],
     "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Rz", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"spherePtsRot", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Rz", ".", "#"}], ")"}], "&"}], "/@", "spherePts"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
