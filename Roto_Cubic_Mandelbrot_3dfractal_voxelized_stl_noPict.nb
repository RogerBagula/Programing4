             RowBox[{"3", " ", 
              SuperscriptBox["xr", "2"], " ", "zr"}], "-", 
             RowBox[{"3", " ", 
              SuperscriptBox["yr", "2"], " ", "zr"}], "+", 
             RowBox[{"2", " ", 
              SuperscriptBox["zr", "3"]}]}]}], ";", "\[IndentingNewLine]", 
