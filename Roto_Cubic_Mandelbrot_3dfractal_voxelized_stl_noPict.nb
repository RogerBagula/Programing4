       RowBox[{"{", 
        RowBox[{"z0", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"maxIter", ",", "_Integer"}], "}"}]}], "}"}], ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
