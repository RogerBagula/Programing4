         RowBox[{"xr", "=", "0."}], ",", 
         RowBox[{"yr", "=", "0."}], ",", 
         RowBox[{"zr", "=", "0."}], ",", "xr2", ",", "yr2", ",", "zr2", ",", 
         RowBox[{"i", "=", "0"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"i", "<", "maxIter"}], ",", 
          RowBox[{
           RowBox[{"xr2", "=", 
            RowBox[{"x0", "+", 
             RowBox[{"2", " ", 
              SuperscriptBox["xr", "3"]}], "-", 
             RowBox[{"3", " ", "xr", " ", 
              SuperscriptBox["yr", "2"]}], "-", 
             RowBox[{"3", " ", "xr", " ", 
              SuperscriptBox["zr", "2"]}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"yr2", "=", 
            RowBox[{"y0", "-", 
             RowBox[{"3", " ", 
              SuperscriptBox["xr", "2"], " ", "yr"}], "+", 
             RowBox[{"2", " ", 
              SuperscriptBox["yr", "3"]}], "-", 
