        RowBox[{
         RowBox[{
          RowBox[{"2", "/", "s"}], "+", 
          RowBox[{"1", "/", 
           RowBox[{"s", "^", "2"}]}], "-", "1"}], "==", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", 
          RowBox[{"N", "[", "GoldenRatio", "]"}]}], "}"}]}], "]"}]}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"af", "=", 
     RowBox[{"1", "/", 
      RowBox[{"N", "[", "S", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"af1", "=", 
     RowBox[{"1", "/", 
      RowBox[{
       RowBox[{"N", "[", "S", "]"}], "^", "2"}]}]}], ";"}], "\n"}]}]], "Input",\

