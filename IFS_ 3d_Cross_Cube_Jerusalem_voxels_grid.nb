Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"IFS", " ", 
     RowBox[{"maps", ":", 
      RowBox[{
      "each", " ", "n", " ", "gives", " ", "a", " ", "map", " ", "v"}]}]}], "->",
     "..."}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Sierpinsky3D1", "[", "n_", "]"}], "[", "v_", "]"}], ":=", 
     RowBox[{
      RowBox[{"af", " ", "v"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "af"}], ")"}], " ", 
       RowBox[{"pieces1", "[", 
        RowBox[{"[", "n", "]"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Sierpinsky3D2", "[", "n_", "]"}], "[", "v_", "]"}], ":=", 
     RowBox[{
      RowBox[{"af1", " ", "v"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "af1"}], ")"}], " ", 
       RowBox[{"pieces2", "[", 
        RowBox[{"[", "n", "]"}], "]"}]}]}]}], ";"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.992610415928864*^9, 3.992610439617879*^9}, 
