      "points"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"oneStepIFS", "[", "ifs_", "]"}], "[", "pts_", "]"}], ":=", 
    RowBox[{"Flatten", "[", 
